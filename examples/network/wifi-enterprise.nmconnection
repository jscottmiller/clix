[connection]
id=CorporateWiFi
uuid=87654321-4321-4321-4321-cba987654321
type=wifi
autoconnect=true

[wifi]
mode=infrastructure
ssid=CorpNetwork

[wifi-security]
key-mgmt=wpa-eap

[802-1x]
eap=peap;
identity=your.username
password=YourPassword
phase2-auth=mschapv2

[ipv4]
method=auto

[ipv6]
method=auto
